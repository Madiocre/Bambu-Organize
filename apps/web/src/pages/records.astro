---
import Shell from "../layouts/Shell.astro";
import { loadAllJobs } from "../server/queries.js";
import { buildRecords, loadSettings } from "../server/records.js";

export const prerender = false;

const [jobs, settings] = await Promise.all([loadAllJobs(), loadSettings()]);
const records = buildRecords(jobs, settings);
---

<Shell title="Records" width="readable">
  <div class="page-head">
    <h1>Records</h1>
    <p>
      What was actually done, for whom, and what it cost. Jobs marked finished, failed or
      cancelled leave the board and land here — nothing is deleted. Paused jobs wait here too,
      and this is where they go back into the queue. Pick a period on the left; there is no
      all-time view because nobody reads a business's whole history in one scroll.
    </p>
  </div>

  <div class="records-layout">
    <aside class="daybar">
      <div class="daybar-head">Period</div>
      <nav data-days class="days"></nav>
    </aside>

    <div class="records-main">
      <div class="tiles" data-totals></div>

  <section class="panel" data-paused-panel hidden>
    <div class="panel-head">
      <h2>Paused</h2>
      <span class="count"><span data-paused-count>0</span> on hold</span>
    </div>
    <div class="panel-body">
      <div data-paused class="paused"></div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Clients</h2>
      <span class="count"><span data-scope-label>—</span> · finished work only</span>
      <span class="spacer"></span>
      <a class="btn" href="/api/records/export?period=last-month" download>Last month report</a>
      <a class="btn" data-scoped-export="clients" href="#" download>Export period</a>
    </div>
    <div class="panel-body" data-clients></div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Job history</h2>
      <span class="count">newest first</span>
      <span class="spacer"></span>
      <a class="btn" data-scoped-export="history" href="#" download>Export period</a>
    </div>
    <div class="panel-body" data-history></div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Rates</h2>
      <span class="count">only materials you have actually printed are listed</span>
    </div>
    <div class="panel-body">
      <form data-settings-form class="rates-form">
        <div class="field">
          <label for="currency">Currency</label>
          <input id="currency" name="currency" maxlength="8" placeholder="EGP, USD, £…" />
        </div>
        <div class="field">
          <label for="machineRatePerHour">Machine rate per hour</label>
          <input
            id="machineRatePerHour"
            name="machineRatePerHour"
            type="number"
            min="0"
            step="0.01"
          />
        </div>
        <div data-filament-prices class="filament-prices"></div>
        <div class="field rates-submit">
          <button class="primary" type="submit">Save rates</button>
        </div>
      </form>
      <p class="footnote">
        Filament is priced <strong>per material</strong>, using the type and grams the slicer
        records for each filament on the plate — so only jobs created from a <code>.3mf</code>
        can be costed in full. Machine time is billed on the print itself, not the changeover
        buffer.
      </p>
    </div>
  </section>

    </div>
  </div>

  <script is:inline type="application/json" id="records-data" set:html={JSON.stringify(records)} />
  <script>
    import { initRecords } from "../scripts/records";

    const raw = document.getElementById("records-data")?.textContent ?? "{}";
    initRecords(JSON.parse(raw));
  </script>
</Shell>

<style>
  .panel + .panel,
  .tiles + .panel {
    margin-top: var(--gap);
  }

  /* A day picker rather than a date range: the question is almost always
     "what did we do on X", and a list of days that actually have work in them
     answers it in one click without a calendar. */
  .records-layout {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .records-main {
    min-width: 0;
  }
  @media (max-width: 860px) {
    .records-layout {
      grid-template-columns: 1fr;
    }
  }

  .daybar {
    position: sticky;
    top: 74px;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .daybar-head {
    padding: 9px 12px;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border);
  }
  .days {
    display: flex;
    flex-direction: column;
    max-height: 60vh;
    overflow-y: auto;
    padding: 5px;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .rates-form {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 12px;
    align-items: end;
  }
  /* Filament prices are a variable-length group, so they get their own grid
     rather than fighting the fixed columns around them. */
  .filament-prices {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0 12px;
    padding-top: 4px;
    border-top: 1px solid var(--border);
    margin-top: 2px;
  }
  .rates-submit {
    margin-bottom: 12px;
  }
  @media (max-width: 820px) {
    .rates-form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<style is:global>
  .day {
    display: flex;
    align-items: baseline;
    gap: 7px;
    padding: 6px 8px;
    border: 0;
    background: transparent;
    border-radius: var(--radius-sm);
    color: var(--text-dim);
    font-size: 12.5px;
    text-align: left;
    cursor: pointer;
    width: 100%;
  }
  .day:hover {
    background: var(--surface);
    color: var(--text);
  }
  .day[aria-current="true"] {
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .day-count {
    margin-left: auto;
    font-size: 11px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .day-group {
    padding: 8px 8px 4px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-faint);
  }
  .day-group:not(:first-child) {
    margin-top: 4px;
    border-top: 1px solid var(--border);
    padding-top: 9px;
  }

  .scope-note {
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 11px 13px;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .tile-label {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
  }
  .tile-value {
    font-size: 21px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .tile-note {
    font-size: 11px;
    color: var(--text-faint);
  }

  /* Tables rather than cards: this page is read in rows and exported to a
     sheet, so the screen should look like the sheet. */
  table.records {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  table.records th {
    text-align: left;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
    font-weight: 600;
    padding: 0 10px 7px;
    border-bottom: 1px solid var(--border);
  }
  table.records td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  table.records tbody tr:last-child td {
    border-bottom: 0;
  }
  table.records tbody tr:hover {
    background: var(--surface);
  }
  table.records .num {
    text-align: right;
    white-space: nowrap;
  }
  table.records td[title] {
    max-width: 34ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status {
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 600;
    background: var(--surface);
    color: var(--text-dim);
  }
  .status-done {
    color: var(--running);
    background: color-mix(in srgb, var(--running) 15%, transparent);
  }
  .status-failed {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 15%, transparent);
  }

  .met {
    color: var(--running);
  }
  .late {
    color: var(--danger);
  }
  .fail {
    color: var(--danger);
  }
  .partial {
    color: var(--warn);
    cursor: help;
  }

  .footnote {
    margin: 10px 0 0;
    font-size: 11.5px;
    color: var(--text-faint);
  }
  .footnote code {
    font-family: var(--mono);
  }

  .paused {
    display: grid;
    gap: 6px;
  }
  .paused-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: var(--bg-sunken);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--warn);
    font-size: 12.5px;
  }
  .paused-title {
    font-weight: 550;
  }
  .paused-row .spacer {
    flex: 1;
  }
</style>
