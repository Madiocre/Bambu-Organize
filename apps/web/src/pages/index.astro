---
import Shell from "../layouts/Shell.astro";
import { loadBoard } from "../server/queries.js";

// The board reads D1 per request, so it can never be prerendered.
export const prerender = false;

// Rendered on the server against D1 directly - no HTTP hop to our own API for
// first paint. The client script takes over from this same payload, so the
// board never flashes an empty state on load.
const board = await loadBoard();
---

<Shell title="Board">
  <select slot="topbar" data-printer-filter aria-label="Filter by printer" class="printer-filter">
  </select>
  <span slot="topbar" class="summary" data-summary></span>

  <div class="board">
    <!-- Row 1: everything that has been added but not committed to a machine. -->
    <section class="panel row-inbox">
      <div class="panel-head">
        <h2>Inbox</h2>
        <span class="count"><span data-count-backlog>0</span> jobs</span>
        <span class="spacer"></span>
        <a class="btn" href="/intake">+ Add job</a>
      </div>
      <div class="panel-body lane-horizontal" data-lane="backlog"></div>
    </section>

    <!--
      Row 2 reads right-to-left into the machine: the queue flows toward the
      printer panel, so its rightmost card is the one going on next. That
      makes a separate "next up" column redundant - it is a badge on the head
      card instead.
    -->
    <div class="row-queue">
      <section class="panel">
        <div class="panel-head">
          <h2>Queue</h2>
          <span class="count"><span data-count-queued>0</span> jobs</span>
          <span class="spacer"></span>
          <span class="flow-hint">next up →</span>
        </div>
        <div class="panel-body lane-queue" data-lane="queued"></div>
      </section>

      <section class="panel panel-printing">
        <div class="panel-head">
          <h2>Now printing</h2>
        </div>
        <div class="panel-body" data-lane="printing"></div>
      </section>
    </div>

    <!--
      Row 3 is unscoped. Until it is, it shows the projected schedule the
      queue math already produces - a strip that is cheap to keep and cheap
      to throw away when this row gets a real job.
    -->
    <section class="panel row-schedule">
      <div class="panel-head">
        <h2>Projected schedule</h2>
        <span class="count">placeholder — row 3 scope TBD</span>
      </div>
      <div class="panel-body" data-schedule></div>
    </section>
  </div>

  <!--
    Native <dialog>: modal behaviour, focus trap, Esc-to-close and the backdrop
    all come free, which is most of what a modal library would be for.
  -->
  <dialog class="edit-dialog" data-edit-dialog>
    <form method="dialog" data-edit-form>
      <h2>Edit job</h2>

      <div class="field span-2">
        <label for="edit-title">Title</label>
        <input id="edit-title" name="title" required />
      </div>

      <div class="field">
        <label for="edit-requestedBy">Requested by</label>
        <input id="edit-requestedBy" name="requestedBy" placeholder="Client" />
      </div>
      <div class="field">
        <label for="edit-printerId">Printer</label>
        <select id="edit-printerId" name="printerId"></select>
      </div>

      <div class="field">
        <label for="edit-hours">Print time (each)</label>
        <div class="duration-input">
          <input id="edit-hours" name="hours" type="number" min="0" max="720" />
          <span>h</span>
          <input name="minutes" type="number" min="0" max="59" />
          <span>m</span>
        </div>
      </div>
      <div class="field">
        <label for="edit-copies">Copies</label>
        <input id="edit-copies" name="copies" type="number" min="1" max="999" />
      </div>

      <div class="field">
        <label for="edit-bufferMin">Changeover</label>
        <input id="edit-bufferMin" name="bufferMin" type="number" min="0" max="600" />
      </div>
      <div class="field">
        <label for="edit-deadline">Deadline</label>
        <input id="edit-deadline" name="deadline" type="datetime-local" />
      </div>

      <div class="field span-2">
        <label for="edit-notes">Notes</label>
        <textarea id="edit-notes" name="notes" rows="2"></textarea>
      </div>

      <p class="edit-hint" data-edit-hint></p>

      <details class="edit-history span-2">
        <summary>History</summary>
        <ol data-edit-history class="event-list"></ol>
      </details>

      <div class="edit-actions span-2">
        <label class="checkbox">
          <input type="checkbox" name="rush" />
          <span>Rush</span>
        </label>
        <span class="spacer"></span>
        <button type="button" data-edit-cancel>Cancel</button>
        <button class="primary" type="submit">Save</button>
      </div>
    </form>
  </dialog>

  <script is:inline type="application/json" id="board-data" set:html={JSON.stringify(board)} />
  <script>
    import { initBoard } from "../scripts/board";

    const raw = document.getElementById("board-data")?.textContent ?? "{}";
    initBoard(JSON.parse(raw));
  </script>
</Shell>

<style>
  .printer-filter {
    width: auto;
    min-width: 180px;
  }

  .summary {
    font-size: 12.5px;
    color: var(--text-dim);
  }

  .board {
    display: grid;
    gap: var(--gap);
    grid-template-rows: auto 1fr auto;
  }

  /* 2/3 queue, 1/3 machine. Fractions rather than fixed widths so the split
     holds at any screen size. */
  .row-queue {
    display: grid;
    gap: var(--gap);
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: stretch;
  }

  @media (max-width: 1080px) {
    .row-queue {
      grid-template-columns: 1fr;
    }
  }

  .flow-hint {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  /*
    Row 1 is work that is *not* in today's plan, so it deliberately reads as a
    parking area rather than a second queue: sunken instead of raised, dashed
    edge, muted header, and compact cards. Before this, the two rows were the
    same cards in the same container and scanned as interchangeable.
  */
  .row-inbox {
    background: var(--bg-sunken);
    border-style: dashed;
  }
  .row-inbox .panel-head h2 {
    color: var(--text-faint);
  }
  .row-inbox .panel-body {
    padding-top: 8px;
  }

  /* Row 1 scrolls sideways: the inbox is a staging strip, not a column. */
  .lane-horizontal {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    overflow-y: hidden;
    min-height: 92px;
    padding-bottom: 6px;
  }
  .lane-horizontal > .empty {
    flex: 1;
  }

  /* row-reverse keeps DOM order head-first while drawing the head on the
     right, next to the printer. Only the drag hit-testing knows about the
     flip; everything else still treats index 0 as "next". */
  .lane-queue {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-start;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    min-height: 150px;
    padding-bottom: 6px;
  }
  .lane-queue > .empty {
    flex: 1;
  }

  .edit-dialog {
    width: min(560px, calc(100vw - 32px));
    padding: 18px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
  }
  .edit-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }
  .edit-dialog h2 {
    grid-column: 1 / -1;
    font-size: 15px;
    margin-bottom: 12px;
  }
  .edit-dialog form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 12px;
  }
  .edit-dialog .span-2 {
    grid-column: 1 / -1;
  }
  .edit-history {
    grid-column: 1 / -1;
    margin-bottom: 12px;
    font-size: 12px;
  }
  .edit-history summary {
    cursor: pointer;
    color: var(--text-dim);
    font-size: 11.5px;
  }
  .event-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0 0 0 12px;
    border-left: 2px solid var(--border);
    display: grid;
    gap: 5px;
    max-height: 160px;
    overflow-y: auto;
  }
  .event-list li {
    display: flex;
    gap: 8px;
    color: var(--text-dim);
    font-size: 11.5px;
  }
  .event-when {
    color: var(--text-faint);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .edit-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }
  .edit-actions .spacer {
    flex: 1;
  }
  .edit-actions .checkbox {
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-dim);
    font-size: 12.5px;
  }
  .edit-actions .checkbox input {
    width: auto;
  }
  .edit-hint {
    grid-column: 1 / -1;
    margin: 0 0 12px;
    font-size: 11.5px;
    color: var(--text-faint);
    min-height: 1.2em;
  }
  .duration-input {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .duration-input span {
    color: var(--text-faint);
    font-size: 12px;
  }

  .panel-printing {
    background: linear-gradient(180deg, rgba(61, 220, 132, 0.06), transparent 55%), var(--bg-raised);
  }
</style>

<style is:global>
  /* Card styles live global because the cards are built by the client script
     and so never get Astro's scoping attribute. */

  .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: start;
    padding: 9px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: grab;
    transition: border-color 120ms ease, background 120ms ease, transform 120ms ease;
  }
  .card:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }
  .card:active {
    cursor: grabbing;
  }
  .card.dragging {
    opacity: 0.4;
    transform: scale(0.98);
  }

  .lane-queue .card {
    flex: 0 0 268px;
  }
  .lane-horizontal .card {
    flex: 0 0 216px;
  }

  /* --- compact: the inbox variant ---
     Quieter than a queue card by design. Filaments and the badge row are
     dropped, the thumbnail shrinks, and the whole thing sits flatter, so a
     glance at the board separates "parked" from "planned" without reading. */
  .card-compact {
    padding: 7px 8px;
    gap: 8px;
    background: transparent;
    border-color: var(--border);
  }
  .card-compact:hover {
    background: var(--surface);
  }
  .card-compact .card-thumb {
    width: 34px;
    height: 34px;
  }
  .card-compact .card-title {
    font-size: 12.5px;
    font-weight: 500;
  }
  .card-compact .card-meta {
    font-size: 11.5px;
    gap: 6px;
  }
  .card-compact .card-filaments {
    display: none;
  }
  .card-compact .card-badges {
    margin-top: 3px;
  }
  /* Only the badges that change a decision survive at this size. */
  .card-compact .card-badges .tag:not(.warn):not(.danger) {
    display: none;
  }
  .card-compact .card-actions {
    gap: 0;
  }

  /* --- deadline flags (inbox only) ---
     A coloured spine rather than a tinted card: it survives being next to
     five other cards, and it does not fight the filament swatches for
     meaning.

     Bands are slack-based - time until the deadline *minus* how long the job
     takes - so a 4h print due tomorrow at 21:00 turns orange at 17:00 today,
     not at 21:00. `flag-none` is deliberately neutral: a job with no deadline
     is not "safe", it simply has no target. */
  .card[class*="flag-"] {
    border-left-width: 3px;
  }
  .card.flag-overdue {
    border-left-color: var(--danger);
  }
  .card.flag-imminent {
    border-left-color: var(--flag-imminent);
  }
  .card.flag-soon {
    border-left-color: var(--flag-soon);
  }
  .card.flag-safe {
    border-left-color: var(--running);
  }
  .card.flag-longterm {
    border-left-color: var(--flag-longterm);
  }
  .card.flag-none {
    border-left-color: var(--border-strong);
  }

  /* --- next up --- */
  .card.is-next {
    position: relative;
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .next-badge {
    position: absolute;
    top: -8px;
    right: 8px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--accent);
    color: #07131f;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-large {
    grid-template-columns: 1fr;
  }
  .card-large .card-thumb {
    width: 100%;
    height: 128px;
  }

  .card-thumb {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    display: grid;
    place-items: center;
    overflow: hidden;
    flex: none;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .card-thumb-empty {
    font-size: 11px;
    color: var(--text-faint);
    font-family: var(--mono);
  }

  .card-main {
    min-width: 0;
  }

  .card-title {
    font-weight: 550;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 2px;
    font-size: 12px;
  }
  .card-meta .duration {
    color: var(--text);
    font-weight: 600;
  }
  .dim {
    color: var(--text-faint);
  }
  .risk {
    color: var(--warn);
  }

  .card-badges,
  .card-filaments {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 5px;
  }

  .card-footnote {
    margin-top: 6px;
    font-size: 11.5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Deadline-pressure chips. These carry an instruction, so they sit ahead of
     the projected start time in the footnote and read louder than it. */
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .chip-hard {
    background: color-mix(in srgb, var(--danger) 22%, transparent);
    color: #ffc9c9;
  }
  .chip-warn {
    background: color-mix(in srgb, var(--warn) 20%, transparent);
    color: var(--warn);
  }
  .chip-ok {
    background: var(--bg-sunken);
    color: var(--text-faint);
    font-weight: 500;
  }

  .queue-index {
    display: inline-grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 5px;
    background: var(--bg-sunken);
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 10.5px;
  }

  .card-actions {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: stretch;
  }
  .card-large .card-actions {
    flex-direction: row;
    margin-top: 8px;
  }

  /* --- drop feedback --- */

  .drop-target {
    outline: 2px dashed color-mix(in srgb, var(--accent) 60%, transparent);
    outline-offset: -4px;
    border-radius: var(--radius-sm);
  }

  .drop-placeholder {
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    flex: none;
  }
  .drop-placeholder.horizontal {
    width: 3px;
    height: auto;
    align-self: stretch;
  }

  /* --- now printing --- */

  .running {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  /* The countdown is the reason this column exists, so it gets the size. */
  .countdown {
    text-align: center;
    padding: 4px 0 2px;
  }
  .countdown-time {
    font-size: 38px;
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--running);
    font-variant-numeric: tabular-nums;
  }
  .countdown-time.overrun {
    color: var(--warn);
  }
  .countdown-label {
    margin-top: 2px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-faint);
  }

  .running-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 12px;
  }
  .running-stat {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .running-stat .label {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
  }
  .running-stat .mono {
    font-size: 13px;
  }
  .running-thumb {
    height: 112px;
    background: var(--bg-sunken);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .running-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .running-title {
    font-size: 15px;
    font-weight: 600;
  }
  .running-sub {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-dim);
  }
  .running-sub .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  .progress {
    height: 7px;
    border-radius: 4px;
    background: var(--bg-sunken);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--running);
    transition: width 400ms ease;
  }

  .running-source {
    font-size: 11px;
    color: var(--text-faint);
  }
  .running-actions {
    display: flex;
    gap: 6px;
    margin-top: 2px;
  }

  /* --- schedule strip --- */

  .schedule-bar {
    display: flex;
    gap: 2px;
    height: 30px;
  }
  .schedule-bar .seg {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    display: flex;
    align-items: center;
    padding: 0 7px;
    min-width: 0;
    overflow: hidden;
    font-size: 11px;
    color: var(--text-dim);
  }
  .schedule-bar .seg span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .schedule-bar .seg.running {
    background: color-mix(in srgb, var(--running) 18%, var(--surface));
    border-color: color-mix(in srgb, var(--running) 40%, transparent);
    color: var(--text);
  }
  .schedule-bar .seg.risk {
    border-color: color-mix(in srgb, var(--warn) 55%, transparent);
    color: var(--warn);
  }
  .schedule-legend {
    display: flex;
    margin-top: 6px;
    font-size: 11.5px;
    color: var(--text-faint);
  }
  .schedule-legend .spacer {
    flex: 1;
  }
</style>
